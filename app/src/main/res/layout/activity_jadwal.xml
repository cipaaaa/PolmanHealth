<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FFFC"
    android:orientation="vertical">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@drawable/bg_dashboard_header"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jadwal Dokter"
            android:textColor="#FFFFFF"
            android:textSize="27sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- HARI -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutHari"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnSenin"
                android:layout_width="82dp"
                android:layout_height="45dp"
                android:background="@drawable/bg_time_outline"
                android:gravity="center"
                android:text="Senin"
                android:textColor="#346C57"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSelasa"
                android:layout_width="82dp"
                android:layout_height="45dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_time_active"
                android:gravity="center"
                android:text="Selasa"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnRabu"
                android:layout_width="82dp"
                android:layout_height="45dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_time_outline"
                android:gravity="center"
                android:text="Rabu"
                android:textColor="#346C57"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnKamis"
                android:layout_width="82dp"
                android:layout_height="45dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_time_outline"
                android:gravity="center"
                android:text="Kamis"
                android:textColor="#346C57"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnJumat"
                android:layout_width="82dp"
                android:layout_height="45dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_time_outline"
                android:gravity="center"
                android:text="Jumat"
                android:textColor="#346C57"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="18dp"
            android:paddingBottom="24dp">

            <!-- DOKTER 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="128dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card_strong"
                android:elevation="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <ImageView
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_circle_photo"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/foto_dokter_2" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="18dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtNamaDokter1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ahmad-Idar, MG."
                        android:textColor="#18382F"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtSpesialis1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Poli Umum"
                        android:textColor="#7A9389"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="10dp"
                        android:background="#E3F4ED" />

                    <TextView
                        android:id="@+id/txtJam1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="◷ 08:00–12:00"
                        android:textColor="#346C57"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- DOKTER 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="128dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_strong"
                android:elevation="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <ImageView
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_circle_photo"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/foto_dokter_1" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="18dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtNamaDokter2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ana, San, MS."
                        android:textColor="#18382F"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtSpesialis2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Poli Gigi"
                        android:textColor="#7A9389"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="10dp"
                        android:background="#E3F4ED" />

                    <TextView
                        android:id="@+id/txtJam2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="◷ 08:00–12:00"
                        android:textColor="#346C57"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- DOKTER 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="128dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_strong"
                android:elevation="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <ImageView
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_circle_photo"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/foto_dokter_3" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="18dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtNamaDokter3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Harrir Sandia, UD."
                        android:textColor="#18382F"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtSpesialis3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Poli Mata"
                        android:textColor="#7A9389"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="10dp"
                        android:background="#E3F4ED" />

                    <TextView
                        android:id="@+id/txtJam3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="◷ 13:00–17:00"
                        android:textColor="#346C57"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- DOKTER 4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="128dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_strong"
                android:elevation="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <ImageView
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_circle_photo"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/foto_dokter_4" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="18dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtNamaDokter4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Drs. Indanoet, MS."
                        android:textColor="#18382F"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtSpesialis4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Poli Umum"
                        android:textColor="#7A9389"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="10dp"
                        android:background="#E3F4ED" />

                    <TextView
                        android:id="@+id/txtJam4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="◷ 08:00–12:00"
                        android:textColor="#346C57"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- DOKTER 5 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="128dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_strong"
                android:elevation="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <ImageView
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_circle_photo"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/foto_dokter_5" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="18dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtNamaDokter5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mto. Samlit"
                        android:textColor="#18382F"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtSpesialis5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Poli Umum"
                        android:textColor="#7A9389"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="10dp"
                        android:background="#E3F4ED" />

                    <TextView
                        android:id="@+id/txtJam5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="◷ 09:00–14:00"
                        android:textColor="#346C57"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:background="#FFFFFF"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="6dp"
            android:text="🏠\nBeranda"
            android:textColor="#A9C9BD"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/navJadwal"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_active"
            android:gravity="center"
            android:padding="6dp"
            android:text="📅\nJadwal"
            android:textColor="#168B68"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navAntrean"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="6dp"
            android:text="🎫\nAntrean"
            android:textColor="#A9C9BD"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/navRiwayat"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="6dp"
            android:text="📁\nRiwayat"
            android:textColor="#A9C9BD"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/navProfil"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="6dp"
            android:text="👤\nProfil"
            android:textColor="#A9C9BD"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>