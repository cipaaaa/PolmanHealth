<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FFFC"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:background="@drawable/bg_dashboard_header"
        android:orientation="vertical"
        android:paddingLeft="22dp"
        android:paddingRight="22dp"
        android:paddingTop="44dp">

        <TextView
            android:id="@+id/tvNamaDokter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Halo, Dokter 👋"
            android:textColor="#FFFFFF"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPoliDokter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Daftar pasien Poli Umum"
            android:textColor="#E6FFF4"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_search"
                android:gravity="center_vertical"
                android:paddingLeft="18dp"
                android:text="⌕  Cari nama pasien..."
                android:textColor="#9DB9AF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ANTREAN PASIEN"
                android:textColor="#08785B"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginTop="18dp" />

            <LinearLayout
                android:id="@+id/cardPasien1"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_strong"
                android:elevation="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <TextView
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_icon_green_light"
                    android:gravity="center"
                    android:text="👤"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_weight="1"
                    android:text="Ahmad Rizki\nPasien Antrean"
                    android:textColor="#18382F"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="76dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_status_green"
                    android:gravity="center"
                    android:text="#A-012"
                    android:textColor="#08785B"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardPasien2"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_strong"
                android:elevation="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <TextView
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_icon_green_light"
                    android:gravity="center"
                    android:text="👤"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_weight="1"
                    android:text="Naila Maharani\nPasien Antrean"
                    android:textColor="#18382F"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="76dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_status_green"
                    android:gravity="center"
                    android:text="#A-013"
                    android:textColor="#08785B"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardPasien3"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_strong"
                android:elevation="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <TextView
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_icon_green_light"
                    android:gravity="center"
                    android:text="👤"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_weight="1"
                    android:text="Diva Putri\nPasien Antrean"
                    android:textColor="#18382F"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="76dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_status_green"
                    android:gravity="center"
                    android:text="#A-014"
                    android:textColor="#666666"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>