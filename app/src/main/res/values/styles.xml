<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="CalendarDay">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#7DA194</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CalendarNum">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#1E332D</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="CalendarActive">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/bg_time_active</item>
    </style>

    <style name="MenuItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#8CBBAA</item>
        <item name="android:textSize">13sp</item>
    </style>

</resources>